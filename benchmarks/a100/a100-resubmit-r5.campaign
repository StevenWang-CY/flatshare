# host, from the home directory:
#   FLATSHARE_NODE_DIR=flatshare/node flatshare/src/benchmarks/e2/campaign.sh --local \
#     flatshare/src/benchmarks/a100/a100-resubmit-r5.campaign

agents-seed 15

