[Unit]
Description=Flatshare E2 arm 8b: SMG 1.13.0's priority scheduler in front of the engine, in the voice-plane namespace
Documentation=https://github.com/StevenWang-CY/flatshare/blob/main/ops/RUNBOOK.md
BindsTo=flatshare-voicenet.service
After=flatshare-voicenet.service flatshare-tunnel@phastform.service

# Not enabled at boot: flatshare-bench e2 run starts it for an arm with router = "smg", whose [gateway] table points the
# gateway's upstream at %t/flatshare/smg.sock, and stops it for every other arm.
[Service]
Type=exec
# deploy/cyan/smg.sh: SMG on the namespace's loopback, between a proxy from smg.sock and one to the engine's tunnel.
ExecStartPre=/usr/bin/rm -f %t/flatshare/smg.sock
ExecStart=%h/flatshare/src/deploy/bin/in-voicenet %h/flatshare/src/deploy/cyan/smg.sh
ExecStartPost=%h/flatshare/src/deploy/bin/wait-healthy --unix-socket %t/flatshare/smg.sock http://localhost/health 60
ExecStopPost=/usr/bin/rm -f %t/flatshare/smg.sock
# Cores 0-7 belong to the control plane, with flatshare-gateway.
CPUAffinity=0-7
Restart=on-failure
RestartSec=5
