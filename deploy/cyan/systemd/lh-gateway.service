[Unit]
Description=Leaseholder gateway on cyan: 127.0.0.1:18080 and the voice-plane socket %t/lh/gateway.sock, from lh-gateway.socket
Documentation=https://github.com/StevenWang-CY/leaseholder/blob/main/ops/RUNBOOK.md
Requires=lh-gateway.socket
After=lh-gateway.socket lh-tunnel@phastform.service

[Service]
# READY=1 (sd_notify) once the gateway has its listeners and is about to serve. On a reload the successor that takes
# the listening sockets over says it is the main process (MAINPID=), which only NotifyAccess=all lets a process
# other than the main one do.
Type=notify
NotifyAccess=all
# The binary is built on a Linux host and copied to bin/; the configuration holds key digests (mode 600).
ExecStartPre=/usr/bin/install -d -m 0700 %t/lh
ExecStart=%h/leaseholder/bin/lh-gateway --config %h/.config/leaseholder/gateway.toml
# `systemctl --user reload lh-gateway` takes a new binary or configuration without a gap: the gateway hands its
# listening sockets to a successor started from the files on disk, then drains (crates/lh-gateway, Lifecycle). It
# fails, and the old process serves on, if the successor does not take over.
ExecReload=%h/leaseholder/src/deploy/bin/lh-gateway-reload %n $MAINPID
# Cores 0-7 belong to the control plane; the voice plane has 32-47.
CPUAffinity=0-7
# Stopping sends SIGTERM: the gateway stops accepting and drains in-flight requests, background ones for
# background_drain_s (5 s) and the rest for up to drain_timeout_s (30 s), well inside systemd's 90 s stop timeout.
# lh-gateway.socket listens on meanwhile, so the connections made until the next gateway serves wait in its backlog
# and none is refused. That is also why a crashed gateway starts again after a second, not five: systemd's start
# limit (5 starts in 10 s) still ends a crash loop, and the socket unit then stops listening.
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
