[Unit]
Description=Flatshare gateway on cyan: 127.0.0.1:18080 and the voice-plane socket %t/flatshare/gateway.sock, from flatshare-gateway.socket
Documentation=https://github.com/StevenWang-CY/flatshare/blob/main/ops/RUNBOOK.md
Requires=flatshare-gateway.socket
After=flatshare-gateway.socket flatshare-tunnel@phastform.service

[Service]
# READY=1 (sd_notify) once the gateway has its listeners and is about to serve. On a reload the successor that takes
# the listening sockets over says it is the main process (MAINPID=), which only NotifyAccess=all lets a process
# other than the main one do.
Type=notify
NotifyAccess=all
# The binary is built on a Linux host and copied to bin/; the configuration holds key digests (mode 600).
ExecStartPre=/usr/bin/install -d -m 0700 %t/flatshare
ExecStart=%h/flatshare/bin/flatshare-gateway --config %h/.config/flatshare/gateway.toml
# `systemctl --user reload flatshare-gateway` takes a new binary or configuration without a gap: the gateway hands its
# listening sockets to a successor started from the files on disk, then drains (crates/flatshare-gateway, Lifecycle). It
# fails, and the old process serves on, if the successor does not take over.
ExecReload=%h/flatshare/src/deploy/bin/flatshare-gateway-reload %n $MAINPID
# Cores 0-7 belong to the control plane; the voice plane has 32-47.
CPUAffinity=0-7
# Stopping sends SIGTERM: the gateway stops accepting and drains in-flight requests, background ones for
# background_drain_s (5 s) and the rest for up to drain_timeout_s (30 s), well inside systemd's 90 s stop timeout.
# ExecStop sends it and waits for the gateway to exit, because after a reload systemd would not: the successor was its
# predecessor's child when it said MAINPID=, and systemd 249 then never waits for that main process ("Supervising
# process ... which is not our child" in the journal) and stops it with SIGKILL at once. ExecStop waits 45 s at most
# (--wait: the drain's 30 s and a margin; raise it with drain_timeout_s), then sends SIGKILL and fails, so that a
# gateway hung in its drain holds a stop up that long, not for twice the stop timeout (ExecStop's, then that of
# systemd's own SIGTERM). On a single host deploy/bin/flatshare-svc runs the line as systemd does, %n included, and
# sends the SIGTERM itself if it fails.
ExecStop=%h/flatshare/src/deploy/bin/flatshare-gateway-stop --wait 45 %n $MAINPID
# flatshare-gateway.socket listens on meanwhile, so the connections made until the next gateway serves wait in its
# backlog and none is refused. That is also why a crashed gateway starts again after a second, not five: systemd's start
# limit (5 starts in 10 s) still ends a crash loop, and the socket unit then stops listening.
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
