def gpu_units(node: str) -> tuple[Unit, ...]:
    """A GPU node's three servers: Phastform's units, with a node's own drop-ins (deploy/NODE/systemd/*.conf, and
    HOST_NETWORK where the node has one, which its install.sh links into all three where the kernel refuses unprivileged
    user namespaces)."""
    box = "deploy/phastform"
    common = ("deploy/bin/in-private-net", "deploy/bin/gpu-guard", "deploy/bin/wait-healthy")
    own = (
        ()
        if node == "phastform"
        else (f"deploy/{node}/systemd/*.conf", f"deploy/{node}/{HOST_NETWORK}")
    )
    return (
        Unit(
            "flatshare-stt.service",
            inputs=(
                f"{box}/stt.yaml",
                f"{box}/systemd/flatshare-stt.service",
                f"{box}/systemd/flatshare.target",
                f"{box}/variants/*/flatshare-stt.conf",
                *common,
                *own,
            ),
            envs=("engine",),
        ),
        Unit(
            "flatshare-tts.service",
            inputs=(
                f"{box}/systemd/flatshare-tts.service",
                f"{box}/systemd/flatshare.target",
                f"{box}/variants/*/flatshare-tts.conf",
                *common,
                *own,
            ),
            envs=("tts",),
        ),
        Unit(
            "flatshare-engine.service",
            inputs=(
                f"{box}/engine.yaml",
                f"{box}/serving.json",
                f"{box}/systemd/flatshare-engine.service",
                f"{box}/systemd/flatshare-engine-proxy.*",
                f"{box}/systemd/flatshare-mps.service",
                f"{box}/systemd/flatshare.target",
                f"{box}/variants/*",
                f"{box}/measure/*",
                "deploy/bin/serving-check",
                "python/flatshare_vllm/src/*",
                *common,
                *own,
            ),
            envs=("engine",),
            drain="engine",
        ),
    )


