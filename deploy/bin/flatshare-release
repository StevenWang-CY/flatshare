"""MANIFEST.json's format."""
PIN = "FLATSHARE_RELEASE"
"""The environment variable that names the release a process tree imports its packages from."""
PYTHON = "3.12"
"""The Python of every environment (the locks are resolved for it)."""
UV_MIN = (0, 11, 27)
"""uv 0.10.8 could not resolve the engine lock's torchcodec==0.17.0+cu130 through --torch-backend."""
MARK = ".flatshare-env.json"
"""Written last into a complete environment: one without it is an interrupted build, removed and built again."""
KEEP = 3
HOST_NETWORK = "private-net-host.conf"
"""A GPU node's drop-in for a kernel that refuses unprivileged user namespaces (deploy/NODE/private-net-host.conf, Gray's),
which its install.sh links into each GPU server's unit when deploy/bin/private-net-check says so: FLATSHARE_PRIVATE_NET=host,
the server in the host's network namespace."""


class ReleaseError(Exception):
    """A check that failed: exit 1."""


class NotReady(Exception):
    """A host, upload or command line this cannot work with: exit 2."""


# What each host runs.


@dataclass(frozen=True)
class Env:
    """A Python environment: ``requirements`` synced with uv pip (with ``args``), or the uv project ``project`` synced
    from its lock with the test extra. ``inputs`` are the release files that decide it, ``vendor`` a checkout outside
    the releases installed editable at a pinned commit (directory under the root, its URL, the commit), and ``check``
    the Python the verification runs in it."""

    name: str
    inputs: tuple[str, ...]
    check: str
    requirements: str | None = None
    project: str | None = None
    args: tuple[str, ...] = ()
    vendor: tuple[str, str, str] | None = None


@dataclass(frozen=True)
class Unit:
    """A unit a release restarts when ``inputs`` (globs of release files, where * crosses directories), ``envs``,
    ``artifacts`` or ``tools`` (the host's, which it runs) changed, and reloads when only ``reload_inputs`` and its
    artifacts did. ``restarts`` are the units that must restart with it (those bound to it); ``drain`` says what its
    restart would cut, to drain first: "voice", the voice worker's calls; "engine", the engine's requests."""

    name: str
    inputs: tuple[str, ...]
    envs: tuple[str, ...] = ()
    artifacts: tuple[str, ...] = ()
    tools: tuple[str, ...] = ()
    reload_inputs: tuple[str, ...] = ()
    restarts: tuple[str, ...] = ()
    drain: str | None = None


@dataclass(frozen=True)
class HostSpec:
    name: str
    node: str  # the directory under deploy/ whose install.sh links the host's units
    envs: tuple[Env, ...]
    units: tuple[Unit, ...]
    artifacts: tuple[str, ...] = ()  # release files that are built, not committed
    tools: dict[str, str] = field(
        default_factory=dict
    )  # host tools under the root, and the version they must say
    gpu: bool = False


