#!/usr/bin/env python3
"""flatshare-forward LISTEN=TARGET...: relay connections from Unix sockets or TCP ports to TCP ports or Unix sockets of this host.

On a single host (docs/HARDWARE.md, single-host mode) the GPU servers serve on Unix sockets only, as the box's do, and
AIPerf speaks TCP only: the A100 run's calibration point (benchmarks/a100/calibration.sh) replays straight to the
engine through flatshare-forward from a loopback port to the engine's socket, as the box's calibration points reached
the engine through the tunnel's TCP forward. LISTEN is a socket path, whose file is mode 600 from its creation
(replacing one left by an earlier run) and is removed when it stops, or HOST:PORT; TARGET is HOST:PORT, or unix: and a
socket's path. An IPv6 HOST goes in brackets: [::1]:18000. Each connection is relayed both ways until both sides have
closed, with Nagle off on its TCP sides; a connection whose target refuses it is closed at once. It runs until SIGTERM
or SIGINT.

    flatshare-forward 127.0.0.1:18000=unix:$XDG_RUNTIME_DIR/flatshare/engine.sock

Standard library only, so that a bare host runs it from the source tree.
"""

from __future__ import annotations

import asyncio
import contextlib
import os
import signal
import socket
import stat
import sys
from pathlib import Path

CHUNK = 64 * 1024


def target(text: str) -> str | tuple[str, int]:
    """A TARGET: a Unix socket's path (``unix:PATH``), or HOST and PORT."""
    if text.startswith("unix:"):
        path = text.removeprefix("unix:")
        if not path.startswith("/"):
            raise ValueError(f"{text!r}: a unix: target names an absolute socket path")
        return path
    return address(text)


def describe(to: str | tuple[str, int]) -> str:
    if isinstance(to, str):
        return f"unix:{to}"
    host, port = to
    return f"[{host}]:{port}" if ":" in host else f"{host}:{port}"


def nodelay(writer: asyncio.StreamWriter) -> None:
    sock = writer.get_extra_info("socket")
    if sock is not None and sock.family in (socket.AF_INET, socket.AF_INET6):
        sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)


def address(text: str) -> tuple[str, int]:
    """HOST:PORT as its host and port; an IPv6 host goes in brackets ([::1]:8000), which a port cannot be told
    from otherwise."""
    host, sep, port = text.rpartition(":")
    bracketed = host.startswith("[") and host.endswith("]")
    if bracketed:
        host = host[1:-1]
    if not sep or not host or not port.isdigit() or (":" in host) != bracketed:
        raise ValueError(f"{text!r} is not HOST:PORT (an IPv6 HOST in brackets: [::1]:8000)")
    return host, int(port)


async def pump(reader: asyncio.StreamReader, writer: asyncio.StreamWriter) -> None:
    """Copy ``reader`` into ``writer`` until it ends, then half-close ``writer``."""
    try:
        while data := await reader.read(CHUNK):
            writer.write(data)
            await writer.drain()
    except (ConnectionError, OSError):
        pass
    finally:
        with contextlib.suppress(OSError, RuntimeError):
            if writer.can_write_eof():
                writer.write_eof()


def relay(to: str | tuple[str, int]):
    async def handle(reader: asyncio.StreamReader, writer: asyncio.StreamWriter) -> None:
        try:
            if isinstance(to, str):
                upstream_reader, upstream_writer = await asyncio.open_unix_connection(to)
            else:
                upstream_reader, upstream_writer = await asyncio.open_connection(*to)
        except OSError:
            writer.close()
            return
        nodelay(writer)
        nodelay(upstream_writer)
        await asyncio.gather(pump(reader, upstream_writer), pump(upstream_reader, writer))
        for side in (writer, upstream_writer):
            side.close()

    return handle


async def unix_server(path: Path, to: str | tuple[str, int]) -> asyncio.Server:
    """A relay to ``to`` on a Unix socket at ``path``, replacing a socket left by an earlier run. The socket's file is
    mode 600 from its creation: bound under umask 177, not changed after, when another user could have connected."""
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    if path.exists() or path.is_symlink():
        if not stat.S_ISSOCK(path.lstat().st_mode):
            raise SystemExit(f"flatshare-forward: {path} exists and is not a socket")
        path.unlink()
    mask = os.umask(0o177)
    try:
        return await asyncio.start_unix_server(relay(to), path=str(path))
    finally:
        os.umask(mask)


async def serve(pairs: list[tuple[str, str | tuple[str, int]]]) -> None:
    servers, sockets = [], []
    for listen, to in pairs:
        if "/" in listen:
            path = Path(listen)
            servers.append(await unix_server(path, to))
            sockets.append(path)
        else:
            host, port = address(listen)
            servers.append(await asyncio.start_server(relay(to), host, port))
    stopped = asyncio.Event()
    loop = asyncio.get_running_loop()
    for signum in (signal.SIGTERM, signal.SIGINT):
        loop.add_signal_handler(signum, stopped.set)
    print(
        "flatshare-forward: " + ", ".join(f"{listen} -> {describe(to)}" for listen, to in pairs),
        flush=True,
    )
    await stopped.wait()
    for server in servers:
        server.close()
    for path in sockets:
        with contextlib.suppress(OSError):
            path.unlink()


def main(argv: list[str]) -> int:
    if not argv or any("=" not in arg for arg in argv):
        print(__doc__.split("\n\n")[0], file=sys.stderr)
        return 2
    try:
        pairs = [(listen, target(to)) for listen, _, to in (a.partition("=") for a in argv)]
    except ValueError as exc:
        print(f"flatshare-forward: {exc}", file=sys.stderr)
        return 2
    asyncio.run(serve(pairs))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
