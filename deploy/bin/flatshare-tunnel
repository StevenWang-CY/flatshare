#!/usr/bin/env python3
"""flatshare-tunnel NODE: GPU node NODE's engine, STT and TTS on this host's Unix sockets, through SSH.

The node serves each on a Unix socket in its own $XDG_RUNTIME_DIR/flatshare (deploy/phastform/systemd). Here each one
gets a socket of its own, $XDG_RUNTIME_DIR/flatshare/NODE-engine.sock, NODE-stt.sock and NODE-tts.sock (mode 0600, in a
directory of mode 0700), and a key of its own, ~/.ssh/flatshare_tunnel_engine_ed25519 and so on, which the node
authorizes for one thing only (deploy/authorize-tunnel.sh): every session of the key runs `exec nc -q0 -U SOCKET`, which
connects the session's stdin and stdout to the node's socket of the same name, under `restrict`, which allows no
forwarding at all. A connection accepted on a socket here becomes one SSH session of its key, `ssh -T -S CONTROL
TARGET`, whose stdin and stdout are the connection itself: the ssh client hands them to its master (ssh -M), which
relays them, so this process copies no byte. Each master is one authenticated connection to the node and carries at most
FLATSHARE_TUNNEL_SESSIONS sessions at a time (sshd's MaxSessions, 10 by default). A connection's session counts against
a master as soon as one has room for it, before its ssh starts, so that a burst of connections spreads over the masters;
until then the connection waits, and a socket keeps enough masters opening for the connections waiting, with a session
to spare. Were each connection without room to connect on its own, a burst would make as many SSH handshakes at once as
it has connections, and sshd drops new ones once 10 are unauthenticated (its default MaxStartups, 10:30:100, drops 30%
of them from there and all from 100), so a gateway restarted with a backlog of requests lost some (the restart drill). A
connection connects on its own only after WAIT_S without room, or when its master refuses the session. After masters
fail in a row a socket opens the next only after a backoff, but no longer than BACKOFF_S[0] while connections wait,
since nothing else serves them: after an outage, the first connection is served about as soon as the node answers. A new
session costs about 12 ms where a new connection costs about 165 ms (OpenSSH 8.9 on loopback), so the servers keep their
connections open between requests.

The environment (the unit's EnvironmentFile, ~/.config/flatshare/tunnel-NODE.env) names the node,
FLATSHARE_TUNNEL_TARGET (user@host), and may set FLATSHARE_TUNNEL_SESSIONS, 1 or more; without a target, or with a
session count that is not one, it exits with status 2 before it listens. It tells systemd it is ready (Type=notify)
once its sockets listen. On SIGTERM or SIGINT it closes its sockets, opens nothing more, and ends its masters and
sessions.
"""

from __future__ import annotations

import asyncio
import contextlib
import os
import signal
import socket
import stat
import sys
import time
from pathlib import Path

SOCKETS = ("engine", "stt", "tts")
MASTERS = 8
"""Masters per socket at most: with sshd's default MaxSessions, 80 connections at once. More wait for room, and those
still waiting after WAIT_S connect on their own, together if they came together, where sshd may drop some."""
OPENING = 3
"""Masters opening at once per socket at most: the three sockets' handshakes together stay under the 10 at once that
sshd's default MaxStartups takes before it drops new connections."""
WAIT_S = 10.0
"""How long a connection waits for a master with room (one opens in about 165 ms) before it connects on its own."""
BACKOFF_S = (1.0, 2.0, 5.0, 10.0, 30.0)
"""How long a socket waits to open a master again after failures in a row, by their number; while connections wait,
no longer than the first."""


def ssh_options(key: Path) -> list[str]:
    return [
        "-i", str(key),
        "-o", "IdentitiesOnly=yes",
        "-o", "BatchMode=yes",
        "-o", "StrictHostKeyChecking=accept-new",
        "-o", "ConnectTimeout=10",
        "-o", "ServerAliveInterval=15",
        "-o", "ServerAliveCountMax=3",
        "-o", "LogLevel=ERROR",
    ]  # fmt: skip


def log(message: str) -> None:
    print(message, file=sys.stderr, flush=True)


class Master:
    """One SSH connection to the node, its control socket, and the sessions it carries."""

    def __init__(self, control: Path) -> None:
        self.control = control
        self.sessions = 0
        self.ready = False
        self.process: asyncio.subprocess.Process | None = None


class Tunnel:
    """One of the node's sockets, served on one of this host's."""

    def __init__(self, node: str, name: str, target: str, runtime: Path, sessions: int) -> None:
        self.name = name
        self.target = target
        self.path = runtime / f"{node}-{name}.sock"
        self.controls = runtime / f"ssh-{node}"
        self.options = ssh_options(Path.home() / ".ssh" / f"flatshare_tunnel_{name}_ed25519")
        self.limit = sessions
        self.masters: list[Master] = []
        self.failures = 0
        self.opened = 0.0
        self.listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.tasks: set[asyncio.Task] = set()
        self.sessions: set[asyncio.subprocess.Process] = set()
        self.waiting = 0
        self.change = asyncio.Event()
        self.closing = False

    def listen(self) -> None:
        with contextlib.suppress(FileNotFoundError):
            if stat.S_ISSOCK(self.path.lstat().st_mode):
                self.path.unlink()  # a dead tunnel's; systemd runs one instance of a unit
        # Mode 600 from its creation: bound under umask 177, not changed after, when another user could have connected.
        mask = os.umask(0o177)
        try:
            self.listener.bind(str(self.path))
        finally:
            os.umask(mask)
        self.listener.listen(128)
        self.listener.setblocking(False)
        # Accepted by hand, so that no event loop ever reads from a connection: each one goes to ssh untouched.
        asyncio.get_running_loop().add_reader(self.listener.fileno(), self.accept)
        self.open_master()

    def close(self) -> None:
        """Stops accepting and ends the masters and the sessions; nothing opens from here on."""
        self.closing = True
        self.wake()
        asyncio.get_running_loop().remove_reader(self.listener.fileno())
        self.listener.close()
        with contextlib.suppress(FileNotFoundError):
            self.path.unlink()
        for process in self.processes():
            end(process)

    def processes(self) -> list[asyncio.subprocess.Process]:
        """The ssh processes still running: the masters and the sessions."""
        masters = [master.process for master in self.masters if master.process]
        return [p for p in [*masters, *self.sessions] if p.returncode is None]

    def spawn(self, coroutine) -> None:
        task = asyncio.get_running_loop().create_task(coroutine)
        self.tasks.add(task)
        task.add_done_callback(self.tasks.discard)

    def backoff(self) -> float:
        """How long after the last master opened another may, after failures in a row (BACKOFF_S)."""
        if not self.failures:
            return 0.0
        backoff = BACKOFF_S[min(self.failures, len(BACKOFF_S)) - 1]
        return min(backoff, BACKOFF_S[0]) if self.waiting else backoff

    def wake(self) -> None:
        """Tells the connections waiting for room to look again: a master's sessions, or the masters, changed."""
        self.change.set()
        self.change = asyncio.Event()

    def open_master(self) -> bool:
        """One more master, unless the socket closes, has its most, has its most opening or waits out failures;
        whether it opened one."""
        if (
            self.closing
            or len(self.masters) >= MASTERS
            or sum(not master.ready for master in self.masters) >= OPENING
            or time.monotonic() - self.opened < self.backoff()
        ):
            return False
        self.opened = time.monotonic()
        used = {master.control.name for master in self.masters}
        name = next(f"{self.name}-{i}" for i in range(MASTERS) if f"{self.name}-{i}" not in used)
        master = Master(self.controls / name)
        self.masters.append(master)
        self.spawn(self.run_master(master))
        return True

    async def run_master(self, master: Master) -> None:
        started = time.monotonic()
        try:
            reason = await self.connect(master)
        except OSError as error:  # its ssh did not start: no file descriptor or memory left, say
            reason = f"ssh did not start: {error}"
        finally:
            # However it ended, the master goes, so that it holds no room it cannot give.
            self.masters.remove(master)
        lasted = time.monotonic() - started
        self.failures = 0 if master.ready and lasted > 60 else self.failures + 1
        log(f"{self.path.name}: master {master.control.name} ended after {lasted:.0f} s: {reason}")
        self.wake()
        if not self.masters and not self.closing:
            await asyncio.sleep(self.backoff())
            self.open_master()  # keep one ready

    async def connect(self, master: Master) -> str:
        """Runs the master's ssh until it ends; why it ended."""
        with contextlib.suppress(FileNotFoundError):
            master.control.unlink()
        process = await asyncio.create_subprocess_exec(
            "ssh", "-M", "-N", "-S", str(master.control), "-o", "ControlPersist=no",
            *self.options, self.target,
            stdin=asyncio.subprocess.DEVNULL, stderr=asyncio.subprocess.PIPE,
        )  # fmt: skip
        master.process = process
        if self.closing:  # closed while it started
            end(process)
        watch = asyncio.get_running_loop().create_task(self.await_control(master))
        try:
            error = await process.stderr.read() if process.stderr else b""
            status = await process.wait()
        finally:
            watch.cancel()
        return error.decode(errors="replace").strip() or f"exit status {status}"

    async def await_control(self, master: Master) -> None:
        """The master is ready once its control socket exists: ssh makes it after the node accepted the key."""
        while not master.control.exists():
            await asyncio.sleep(0.05)
        master.ready = True
        self.failures = 0
        log(f"{self.path.name}: master {master.control.name} connected to {self.target}")
        self.wake()

    def free(self) -> int:
        """The sessions the masters can still take: a ready one's room, an opening one's whole."""
        return sum(self.limit - m.sessions if m.ready else self.limit for m in self.masters)

    def take(self) -> Master | None:
        """The ready master with the fewest sessions, if one has room, with a session counted against it at once; and
        enough masters opening for the connections still waiting, with a session to spare."""
        ready = [master for master in self.masters if master.ready and master.sessions < self.limit]
        master = min(ready, key=lambda master: master.sessions, default=None)
        if master:
            master.sessions += 1
        waiting = self.waiting - 1 if master else self.waiting
        while self.free() <= waiting and self.open_master():
            pass
        return master

    async def room(self) -> Master | None:
        """A master with room for one more session, counted against it, waiting up to WAIT_S for one; None after
        that, or once the socket closes."""
        deadline = time.monotonic() + WAIT_S
        self.waiting += 1
        try:
            while not self.closing:
                change = self.change
                master = self.take()
                now = time.monotonic()
                if master or now >= deadline:
                    return master
                # It looks again at a change, or once the backoff ends, when a master may open for it.
                backoff = self.opened + self.backoff() - now
                timeout = min(deadline - now, backoff) if backoff > 0 else deadline - now
                # asyncio's TimeoutError: Python 3.10's is not the builtin one.
                with contextlib.suppress(asyncio.TimeoutError):
                    await asyncio.wait_for(change.wait(), timeout)
            return None
        finally:
            self.waiting -= 1

    def accept(self) -> None:
        while True:
            try:
                connection, _ = self.listener.accept()
            except BlockingIOError:
                return
            self.spawn(self.relay(connection))

    async def relay(self, connection: socket.socket) -> None:
        master = await self.room()
        session = None
        try:
            if self.closing:
                connection.close()
                return
            # Without a master that has room the session connects on its own (ControlPath none).
            control = str(master.control) if master else "none"
            try:
                session = await asyncio.create_subprocess_exec(
                    "ssh", "-T", "-S", control, "-o", "ControlMaster=no", *self.options, self.target,
                    stdin=connection.fileno(), stdout=connection.fileno(), stderr=asyncio.subprocess.PIPE,
                )  # fmt: skip
            finally:
                connection.close()  # the session holds the connection now
            self.sessions.add(session)
            if self.closing:  # closed while it started
                end(session)
            error = await session.stderr.read() if session.stderr else b""
            status = await session.wait()
        finally:
            if session is not None:
                self.sessions.discard(session)
            if master:
                master.sessions -= 1
                self.wake()
        # nc exits 1 when the node's server does not answer, which the client sees as a closed connection; any other
        # failure is the tunnel's.
        if status not in (0, 1):
            text = error.decode(errors="replace").strip()
            log(f"{self.path.name}: a session ended with exit status {status}: {text}")


def end(process: asyncio.subprocess.Process) -> None:
    with contextlib.suppress(ProcessLookupError):
        process.terminate()


def notify(state: str) -> None:
    """Tell systemd how the service is (Type=notify), when it asks."""
    address = os.environ.get("NOTIFY_SOCKET", "")
    if not address:
        return
    if address.startswith("@"):
        address = "\0" + address[1:]
    with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as notifier:
        notifier.sendto(state.encode(), address)


async def main(node: str) -> int:
    target = os.environ.get("FLATSHARE_TUNNEL_TARGET", "")
    if not target:
        log(
            f"flatshare-tunnel: no FLATSHARE_TUNNEL_TARGET for {node} (~/.config/flatshare/tunnel-{node}.env)"
        )
        return 2
    setting = os.environ.get("FLATSHARE_TUNNEL_SESSIONS") or "10"
    try:
        sessions = int(setting)
    except ValueError:
        sessions = 0
    if sessions < 1:
        log(
            "flatshare-tunnel: FLATSHARE_TUNNEL_SESSIONS is the sessions a master carries at once, a number of "
            f"1 or more (sshd's MaxSessions, 10 by default), not {setting!r} "
            f"(~/.config/flatshare/tunnel-{node}.env)"
        )
        return 2
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}") / "flatshare"
    for directory in (runtime, runtime / f"ssh-{node}"):
        directory.mkdir(mode=0o700, parents=True, exist_ok=True)
        directory.chmod(0o700)
    tunnels = [Tunnel(node, name, target, runtime, sessions) for name in SOCKETS]
    for tunnel in tunnels:
        tunnel.listen()
    log(
        f"flatshare-tunnel: {node} ({target}) on {', '.join(str(tunnel.path) for tunnel in tunnels)}"
    )
    notify("READY=1")
    stop = asyncio.Event()
    for signum in (signal.SIGTERM, signal.SIGINT):
        asyncio.get_running_loop().add_signal_handler(signum, stop.set)
    await stop.wait()
    notify("STOPPING=1")
    # systemd would stop the masters and sessions with the unit too; a tunnel run by hand leaves nothing behind
    # either. Each task ends once its process has. OpenSSH 8.9's client loop waits in poll() with signals unblocked
    # (clientloop.c, client_wait_until_can_do_something), so a SIGTERM that lands just before it blocks is seen only
    # at its next event, up to ServerAliveInterval later: those still running get a second one.
    for tunnel in tunnels:
        tunnel.close()
    tasks = [task for tunnel in tunnels for task in tunnel.tasks]
    if tasks:
        _, running = await asyncio.wait(tasks, timeout=0.5)
        if running:
            for tunnel in tunnels:
                for process in tunnel.processes():
                    end(process)
            await asyncio.wait(running, timeout=4.5)
    for tunnel in tunnels:
        for process in tunnel.processes():
            process.kill()
    return 0


if __name__ == "__main__":
    if len(sys.argv) != 2:
        log("usage: flatshare-tunnel NODE")
        sys.exit(2)
    sys.exit(asyncio.run(main(sys.argv[1])))
