#!/usr/bin/env bash
# voicenet-holder PIDFILE: create an unprivileged user and network namespace for the voice plane, write the
# holder's pid to PIDFILE, and keep the namespace alive. The voice plane (LiveKit server, voice worker, bots) runs
# inside it: libwebrtc gathers ICE candidates on every non-loopback interface, so on a host with a public address
# this is the only way to keep media sockets off the network.
#
# Besides loopback the namespace holds one dummy interface. libwebrtc ignores loopback adapters, so with lo alone a
# client gathers no candidate and media never connects; the dummy gives clients an address to bind. It has no
# default route and no IPv6 link-local address, so nothing leaves the namespace.
#
# With FLATSHARE_VOICENET=host, on a host whose kernel refuses unprivileged user namespaces (the preflight finds out),
# it holds no namespace: it writes "host" to PIDFILE, and in-voicenet then runs the voice plane in the host's network
# namespace. LiveKit's own candidates stay on 127.0.0.1 (deploy/cyan/livekit.yaml), but the clients gather theirs on the
# host's interfaces, so such a host must not be reachable from outside on the media ports.
set -euo pipefail
if [[ ${FLATSHARE_VOICENET:-} == host ]]; then
  echo host >"$1"
  exec sleep infinity
fi
exec unshare --user --map-root-user --net -- sh -c '
  ip link set lo up &&
  ip link add flatshare0 type dummy &&
  ip link set flatshare0 addrgenmode none &&
  ip addr add 10.255.0.1/32 dev flatshare0 &&
  ip link set flatshare0 up &&
  echo $$ >"$1" &&
  exec sleep infinity' sh "$1"
