#!/usr/bin/env python3
"""serving-check: hold what a box serves to its serving profile's effective configuration.

    serving-check SERVING_JSON [--engine FILE [--pid PID]] [--voice FILE [--voice-pid PID]] [--nodes FILE]
                  [--root DIR]

SERVING_JSON is a serving profile's serving.json (deploy/profile.py renders it; deploy/phastform's is the box's):
every setting the engine must run with, the vLLM version, the SHA-256 of the scheduler module it must load and of the
patches that module is built from, and the voice worker's admission. A production box serves no /server_info (vLLM's
development mode is the measurement drop-in's), so the engine says what it runs itself: the make-room-serve variant's
scheduler writes the configuration it was built with to FLATSHARE_ENGINE_EFFECTIVE as the engine starts
(python/flatshare_vllm's serve module), and --engine names that file. With --pid, the engine unit's main process, the
file must have been written by that process or by its engine core, a child of it, so that a file an earlier start left
never passes; the variant removes it before each start too. --voice names the voice worker's status file, which its
serve mode writes (FLATSHARE_VOICE_STATUS), and --voice-pid its unit's main process. --nodes names the gateway's
GET /nodes answer, which it holds to the profile's envelope: every node with the realtime role has the call slots the
worker admits, every node that carries calls beside its own agents (the first realtime node with calls = "fill",
every one with "spread") holds its agents' sessions to the profile's max_agents or fewer, and a covering node's
agents in flight are held to as few. --root is the release whose patches are compared (by default the tree this
script is in).

It prints each setting of the profile with the value the engine runs where they differ, and the patches, then a
verdict. The variant runs it after each start (ExecStartPost), so that an engine that runs anything else, a flag over
the profile's or another module, fails its start; deploy/bin/flatshare-release runs it at each release.

Exit status: 0 when everything runs the profile's configuration exactly; 1 when a setting differs, each named; 2 when
a file is missing or unreadable, or not the engine's own (another process's, or of another format).

Standard library only, for the host's python3 (3.10 or newer).
"""

from __future__ import annotations

import argparse
import hashlib
import json
import re
import sys
import time
from pathlib import Path
from typing import Any

SCHEMA = 1
"""The format of the effective configuration and of the worker's status (the serve module's and worker.py's)."""
MISSING = object()
PATCHES = Path("python/flatshare_vllm/src/flatshare_vllm/make-room")
"""Where a release keeps make-room's patches, relative to its root."""


SNAPSHOT = re.compile(
    r"(?:^|/)models--(?P<org>[^/]+?)--(?P<name>[^/]+)/snapshots/(?P<revision>[0-9a-f]{40})/?$"
)
"""A model in Hugging Face's cache, as vLLM names it once it has resolved the model offline: the directory of one
revision of ORG/NAME."""


def as_named(engine: dict) -> dict:
    """The engine's report with a model or tokenizer that vLLM resolved to a snapshot in Hugging Face's cache read as
    the ORG/NAME the snapshot is of, when the snapshot's revision is the revision the report gives for it (or the report
    gives none, and takes the snapshot's); a snapshot of another revision stays a path, and differs."""
    model = engine.get("model")
    if not isinstance(model, dict):
        return engine
    named = dict(model)
    for key, revision in (("model", "revision"), ("tokenizer", "tokenizer_revision")):
        found = SNAPSHOT.search(str(model.get(key, "")))
        if found is None or model.get(revision) not in (None, found["revision"]):
            continue
        named[key] = f"{found['org']}/{found['name']}"
        named[revision] = found["revision"]
    return {**engine, "model": named}


class Unreadable(Exception):
    """A file the check cannot hold anything to: exit 2."""


def read_json(path: Path, what: str) -> dict:
    try:
        data = json.loads(path.read_text())
    except FileNotFoundError:
        raise Unreadable(f"no {what} at {path}") from None
    except (OSError, ValueError) as error:
        raise Unreadable(f"{what} {path} is unreadable: {error}") from None
    if not isinstance(data, dict):
        raise Unreadable(f"{what} {path} is no JSON object")
    return data


def same(want: Any, have: Any) -> bool:
    """Equal and of one kind: true is not 1, and 0.7 is 0.7 whether written 0.70 or not."""
    if isinstance(want, bool) or isinstance(have, bool):
        return type(want) is type(have) and want == have
    return want == have


def leaves(expected: dict, actual: Any, prefix: str) -> list[tuple[str, Any, Any]]:
    """Each setting of ``expected``, by its dotted name, with ``actual``'s value of it (MISSING where it has none)."""
    rows = []
    for key, want in expected.items():
        name = f"{prefix}.{key}"
        have = actual.get(key, MISSING) if isinstance(actual, dict) else MISSING
        if isinstance(want, dict):
            rows += leaves(want, have, name)
        else:
            rows.append((name, want, have))
    return rows


class AtMost:
    """A bound a setting may meet or stay under, as a node's agents' bound stays under the envelope's."""

    def __init__(self, bound: int) -> None:
        self.bound = bound

    def holds(self, have: Any) -> bool:
        return isinstance(have, int) and not isinstance(have, bool) and have <= self.bound


def shown(value: Any) -> str:
    if isinstance(value, AtMost):
        return f"at most {value.bound}"
    return "nothing" if value is MISSING else json.dumps(value)


def envelope(serving: dict, view: dict) -> list[tuple[str, Any, Any]]:
    """The settings of the gateway's nodes (its GET /nodes answer) that the profile's envelope bounds, each with the
    profile's value or bound."""
    nodes, placement = view.get("nodes"), view.get("placement")
    if not isinstance(nodes, list) or not isinstance(placement, dict):
        raise Unreadable("the gateway's nodes have no placement: a gateway older than this check")
    calls, agents = serving["voice"]["max_calls"], AtMost(serving["gateway"]["max_agents"])
    realtime = [node for node in nodes if "realtime" in node.get("roles", ())]
    # With "fill" only the first realtime node carries calls beside its own agents: a later one covers while it
    # carries any, its agents held to the placement's bound.
    beside = realtime[:1] if placement.get("calls") == "fill" else realtime
    rows = [
        (f"nodes.{node.get('name')}.max_calls", calls, node.get("max_calls", MISSING))
        for node in realtime
    ]
    rows += [
        (f"nodes.{node.get('name')}.max_agents", agents, node.get("max_agents", MISSING))
        for node in beside
        if "background" in node.get("roles", ())
    ]
    if len(realtime) > 1:
        key = "failover_background_max_in_flight"
        rows.append((f"placement.{key}", agents, placement.get(key, MISSING)))
    return rows


def written_by(report: dict, pid: int | None, what: str) -> str:
    """Says which process wrote ``report``, or raises Unreadable when it is not ``pid`` or a child of it."""
    if report.get("schema") != SCHEMA:
        raise Unreadable(f"the {what} has schema {report.get('schema')!r}, not {SCHEMA}")
    writer, parent = report.get("pid"), report.get("ppid")
    if pid is not None and pid not in (writer, parent):
        raise Unreadable(
            f"the {what} was written by pid {writer} (parent {parent}), not by pid {pid} or a child of it: "
            "a file of an earlier start"
        )
    stamp = report.get("written_at") or report.get("updated")
    when = (
        time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(stamp))
        if isinstance(stamp, (int, float))
        else "at an unknown time"
    )
    return f"pid {writer}, {when}"


def check(
    serving: dict,
    engine: dict | None,
    engine_pid: int | None,
    voice: dict | None,
    voice_pid: int | None,
    nodes: dict | None,
    root: Path,
) -> tuple[list[str], list[str]]:
    """The lines to print and the names of the settings that differ."""
    lines, differ = [], []
    name = serving.get("profile", "the profile")

    def compare(rows: list[tuple[str, Any, Any]]) -> None:
        width = max((len(row[0]) for row in rows), default=0)
        for key, want, have in rows:
            if want.holds(have) if isinstance(want, AtMost) else same(want, have):
                lines.append(f"  {key:<{width}}  {shown(want)}")
            else:
                lines.append(f"  {key:<{width}}  {shown(want)}  DIFFERS: runs {shown(have)}")
                differ.append(key)

    if engine is not None:
        lines.append(
            f"serving-check: {name}'s engine, against the configuration the engine wrote ({written_by(engine, engine_pid, 'effective configuration')}):"
        )
        compare(leaves(serving["engine"], as_named(engine), "engine"))
    lines.append(
        f"serving-check: {name}'s make-room patches, against the release's in {root / PATCHES}:"
    )
    patches = []
    for patch, want in serving.get("patches", {}).items():
        path = root / PATCHES / patch
        have = hashlib.sha256(path.read_bytes()).hexdigest() if path.is_file() else MISSING
        patches.append((f"patches.{patch}", want, have))
    compare(patches)
    if voice is not None:
        lines.append(
            f"serving-check: {name}'s voice worker, against its status ({written_by(voice, voice_pid, 'voice status')}):"
        )
        compare(leaves(serving["voice"], voice, "voice"))
    if nodes is not None:
        lines.append(f"serving-check: {name}'s envelope, against the gateway's nodes:")
        compare(envelope(serving, nodes))
    return lines, differ


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="serving-check", description=__doc__.split("\n\n")[0])
    parser.add_argument("serving", type=Path, help="the serving profile's serving.json")
    parser.add_argument(
        "--engine", type=Path, help="the configuration the engine wrote at its start"
    )
    parser.add_argument("--pid", type=int, help="the engine unit's main process ($MAINPID)")
    parser.add_argument("--voice", type=Path, help="the voice worker's status file (serve mode)")
    parser.add_argument("--voice-pid", type=int, help="the voice worker unit's main process")
    parser.add_argument("--nodes", type=Path, help="the gateway's GET /nodes answer")
    parser.add_argument(
        "--root",
        type=Path,
        default=Path(__file__).resolve().parents[2],
        help="the release whose patches to compare (default: this script's)",
    )
    args = parser.parse_args(argv)
    try:
        serving = read_json(args.serving, "serving profile")
        if "engine" not in serving or "voice" not in serving:
            raise Unreadable(f"{args.serving} is no serving profile's serving.json")
        engine = read_json(args.engine, "effective configuration") if args.engine else None
        voice = read_json(args.voice, "voice status") if args.voice else None
        nodes = read_json(args.nodes, "gateway's nodes") if args.nodes else None
        if nodes is not None and "gateway" not in serving:
            raise Unreadable(f"{args.serving} names no gateway envelope to hold the nodes to")
        lines, differ = check(serving, engine, args.pid, voice, args.voice_pid, nodes, args.root)
    except Unreadable as error:
        print(f"serving-check: {error}", file=sys.stderr)
        return 2
    print("\n".join(lines))
    name = serving.get("profile", args.serving)
    if differ:
        print(
            f"serving-check: {len(differ)} setting(s) differ from {name}'s: {', '.join(differ)}",
            file=sys.stderr,
        )
        return 1
    checked = [
        what
        for what, given in (("engine", engine), ("voice worker", voice), ("gateway's nodes", nodes))
        if given is not None
    ]
    print(f"serving-check: ok: {' and '.join([*checked, 'patches'])} as {name} names them")
    return 0


if __name__ == "__main__":
    sys.exit(main())
