[Unit]
Description=Leaseholder engine socket for an engine that serves TCP only (variant sglang): %t/lh/engine.sock
Documentation=https://github.com/StevenWang-CY/leaseholder/blob/main/ops/RUNBOOK.md
# The sglang variant's drop-in wants it. It starts once the engine serves on its loopback port and stops with it, so
# that a vLLM engine finds the path free.
BindsTo=lh-engine.service
After=lh-engine.service

[Socket]
ListenStream=%t/lh/engine.sock
SocketMode=0600
RemoveOnStop=yes
