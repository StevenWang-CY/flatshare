[Unit]
Description=Leaseholder STT: vLLM 0.32, whisper-large-v3-turbo on %t/lh/stt.sock
Documentation=https://github.com/StevenWang-CY/leaseholder/blob/main/ops/RUNBOOK.md
PartOf=leaseholder.target
StartLimitIntervalSec=1800
StartLimitBurst=3

[Service]
Type=exec
WorkingDirectory=%h/leaseholder
Environment=PATH=%h/leaseholder/venvs/engine/bin:/usr/local/cuda/bin:/usr/local/bin:/usr/bin:/bin
Environment=HF_HUB_OFFLINE=1
# The FlashInfer sampler would JIT-compile at warm-up; Whisper does not need it.
Environment=VLLM_USE_FLASHINFER_SAMPLER=0
# Keep idle HTTP connections for 60 s (vLLM's default is 5 s), as the engine does: through the tunnel each new
# connection is a new SSH session, about 12 ms, which the turns seconds apart would otherwise pay for most turns.
Environment=VLLM_HTTP_TIMEOUT_KEEP_ALIVE=60
# On a Unix socket in a directory only this user may enter, as the engine (lh-engine.service says why).
Environment=LH_STT_SOCKET=%t/lh/stt.sock
Environment=VLLM_RPC_BASE_PATH=%t/lh
ExecStartPre=/usr/bin/install -d -m 0700 %t/lh
ExecStartPre=/usr/bin/rm -f ${LH_STT_SOCKET}
ExecStartPre=%h/leaseholder/src/deploy/bin/gpu-guard
ExecStart=%h/leaseholder/venvs/engine/bin/vllm serve --config %h/leaseholder/src/deploy/phastform/stt.yaml --uds ${LH_STT_SOCKET}
ExecStartPost=%h/leaseholder/src/deploy/bin/wait-healthy --unix-socket ${LH_STT_SOCKET} --pid=${MAINPID} http://localhost/health 900
# NUMA node 0 (cores 0-7) for the audio servers; node 1, local to the GPU, is the engine's.
CPUAffinity=0-7
NUMAPolicy=preferred
NUMAMask=0
KillSignal=SIGINT
TimeoutStartSec=1000
TimeoutStopSec=60
Restart=on-failure
# From the exit of the unit's last process, as lh-engine's: pure wait; StartLimitBurst ends a crash loop.
RestartSec=5
