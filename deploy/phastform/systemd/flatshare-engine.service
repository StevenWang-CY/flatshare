[Unit]
Description=Flatshare LLM engine: vLLM 0.32, Qwen3-4B-Instruct-2507-FP8 on %t/flatshare/engine.sock
Documentation=https://github.com/StevenWang-CY/flatshare/blob/main/ops/RUNBOOK.md
PartOf=flatshare.target
# No After= on the audio servers: flatshare.target starts the three at once. Neither vLLM server sizes its pool from
# the memory free at its start, both KV pools being fixed (kv-cache-memory), so their order matters only to each one's
# free-memory check at start, and that passes in any order wherever starting the audio servers first passed: the
# engine's worst case, the audio servers resident, is that order's, and the STT's, the engine resident, holds while the
# two budgets and the TTS's share fit the card together, the engine within its budget, which deploy/profile.py checks
# (R2). A server starting still peaks above its steady state (vLLM's profiling pass and graph capture): a check that
# meets that peak has the margin the budgets leave (on the box 1.1 GiB at the engine's, 1.9 GiB at the STT's), and
# Restart=on-failure starts a server that lost again.
StartLimitIntervalSec=1800
StartLimitBurst=3

[Service]
Type=exec
WorkingDirectory=%h/flatshare
# DeepGEMM's FP8 kernels JIT-compile with nvcc >= 13.0. FlashInfer's JIT also needs curand headers, which the
# CUDA 13.0 toolkit on this host lacks; bootstrap.sh links the venv's copies into cache/curand_include.
Environment=CUDA_HOME=/usr/local/cuda-13.0
# vLLM's /server_info (the measurement drop-in's, deploy/phastform/measure) lists the venv's packages with `uv pip list`
# when the venv has no pip, so uv (in ~/.local/bin) is on the path and VIRTUAL_ENV names the venv; without them the
# endpoint answers 500.
Environment=PATH=%h/flatshare/venvs/engine/bin:/usr/local/cuda-13.0/bin:/usr/local/bin:/usr/bin:/bin:%h/.local/bin
Environment=VIRTUAL_ENV=%h/flatshare/venvs/engine
Environment=FLASHINFER_EXTRA_CUDAFLAGS=-I%h/flatshare/cache/curand_include
Environment=FLASHINFER_EXTRA_CFLAGS=-I%h/flatshare/cache/curand_include
Environment=FLASHINFER_WORKSPACE_BASE=%h/flatshare/cache/flashinfer
Environment=HF_HUB_OFFLINE=1
# Keep idle HTTP connections for 60 s (vLLM's default is 5 s), so the gateway's pooled connections survive the
# seconds between voice turns instead of being reopened for most of them.
Environment=VLLM_HTTP_TIMEOUT_KEEP_ALIVE=60
# The engine serves on a Unix socket in a directory only this user may enter: vLLM's --api-key guards only its /v1,
# /v2, /inference and /cohere routes, and every user of the host reaches its loopback. vLLM binds the path without
# removing the file a killed engine leaves (launchers/launcher.py, create_server_unix_socket), so the unit removes it
# first. The ZMQ sockets between its API server and its engine core go in a directory of the unit's own there
# (VLLM_RPC_BASE_PATH; /tmp by default), which the unit empties first: vLLM names them afresh at each start and removes
# none at a stop, so a directory that every start shared would keep them all.
Environment=FLATSHARE_ENGINE_SOCKET=%t/flatshare/engine.sock
Environment=VLLM_RPC_BASE_PATH=%t/flatshare/engine.zmq
ExecStartPre=/usr/bin/install -d -m 0700 %t/flatshare
ExecStartPre=/usr/bin/rm -f ${FLATSHARE_ENGINE_SOCKET}
ExecStartPre=/usr/bin/rm -rf ${VLLM_RPC_BASE_PATH}
ExecStartPre=/usr/bin/install -d -m 0700 ${VLLM_RPC_BASE_PATH}
ExecStartPre=%h/flatshare/src/deploy/bin/gpu-guard
# The engine runs in a network namespace of its own (deploy/bin/in-private-net), where no other user of the host
# reaches the listeners its engine core keeps on the loopback (torch's gloo groups) or CUDA's abstract sockets; its
# socket is a file, which every namespace reaches. A variant that replaces ExecStart keeps the wrapper.
# Variants add engine flags in FLATSHARE_ENGINE_FLAGS (deploy/phastform/variant.sh use NAME FLAG...); flags on the
# command line beat engine.yaml.
Environment=FLATSHARE_ENGINE_FLAGS=
ExecStart=%h/flatshare/src/deploy/bin/in-private-net %h/flatshare/venvs/engine/bin/vllm serve --config %h/flatshare/src/deploy/phastform/engine.yaml --uds ${FLATSHARE_ENGINE_SOCKET} $FLATSHARE_ENGINE_FLAGS
ExecStartPost=%h/flatshare/src/deploy/bin/wait-healthy --unix-socket ${FLATSHARE_ENGINE_SOCKET} --pid=${MAINPID} http://localhost/health 1200
# NUMA node 1 is local to the GPU. "preferred" spills to node 0 when node 1 is short: the measured cost of a remote
# CPU tier is under 1% of pinned bandwidth.
CPUAffinity=8-15
NUMAPolicy=preferred
NUMAMask=1
KillSignal=SIGINT
TimeoutStartSec=1300
TimeoutStopSec=90
Restart=on-failure
# systemd counts RestartSec from the exit of the unit's last process, so after the GPU's teardown (7.7 s after a
# SIGKILL in the W8 engine-kill drill): it is pure wait before a start that takes about 90 s, and StartLimitBurst=3
# in 30 min ends a crash loop whatever it is.
RestartSec=5
