[Unit]
Description=Flatshare TTS: Kokoro-82M on Kokoro-FastAPI 0.9.1-rc1 at %t/flatshare/tts.sock
Documentation=https://github.com/StevenWang-CY/flatshare/blob/main/ops/RUNBOOK.md
PartOf=flatshare.target
StartLimitIntervalSec=1800
StartLimitBurst=3

[Service]
Type=exec
WorkingDirectory=%h/flatshare/vendor/Kokoro-FastAPI
# The same environment as the upstream start-gpu.sh, without its install step (its default extra ships cu126
# wheels, which have no sm_120 kernels; bootstrap.sh installs the gpu-cu128 extra instead).
Environment=USE_GPU=true
Environment=PYTHONPATH=%h/flatshare/vendor/Kokoro-FastAPI:%h/flatshare/vendor/Kokoro-FastAPI/api
Environment=MODEL_DIR=src/models
Environment=VOICES_DIR=src/voices/v1_0
Environment=WEB_PLAYER_PATH=%h/flatshare/vendor/Kokoro-FastAPI/web
# Kokoro-FastAPI logs at DEBUG unless told otherwise, and at INFO it logs the first 50 characters of each chunk of
# text it speaks: the agent's replies, which can repeat what a caller said. Its warnings and errors keep them out of
# the journal.
Environment=API_LOG_LEVEL=WARNING
# On a Unix socket in a directory only this user may enter, as the engine (flatshare-engine.service says why). uvicorn
# replaces a stale socket file itself and makes the new one 0666 (uvicorn 0.34.0, server.py), so the directory's mode is
# what keeps the host's other users out. Idle connections stay 60 s (uvicorn's default is 5 s), as the engine's: through
# the tunnel each new connection is a new SSH session, about 12 ms. In a network namespace of its own, as the
# engine (flatshare-engine.service says why): CUDA's abstract sockets are the TTS's too.
ExecStartPre=/usr/bin/install -d -m 0700 %t/flatshare
ExecStartPre=%h/flatshare/src/deploy/bin/gpu-guard
ExecStart=%h/flatshare/src/deploy/bin/in-private-net %h/flatshare/venvs/tts/bin/uvicorn api.src.main:app --uds %t/flatshare/tts.sock --timeout-keep-alive 60 --no-access-log
ExecStartPost=%h/flatshare/src/deploy/bin/wait-healthy --unix-socket %t/flatshare/tts.sock --pid=${MAINPID} http://localhost/health 600
# NUMA node 0 (cores 0-7) for the audio servers; node 1, local to the GPU, is the engine's.
CPUAffinity=0-7
NUMAPolicy=preferred
NUMAMask=0
KillSignal=SIGINT
TimeoutStartSec=700
TimeoutStopSec=60
Restart=on-failure
# From the exit of the unit's last process, as flatshare-engine's: pure wait; StartLimitBurst ends a crash loop.
RestartSec=5
