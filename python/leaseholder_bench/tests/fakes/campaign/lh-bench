#!/usr/bin/env bash
# lh-bench on cyan in the campaign.sh tests (leaseholder/venvs/bench/bin/lh-bench of the host's home). `e2 engine` is
# the real one ($FAKE_LH_BENCH), which reads the arm file; `e2 run` writes a complete point's run.json as e2 run does;
# `e2 report` and `e2 reset` do what campaign.sh needs; `tiers --out DIR` writes an E0 summary.json, as the A100 dry
# run's probe blocks read it. Each call goes to lh-bench.log in the home. A point lasts until a GPU node's sampler has
# its first sample (at most 5 s), as a real one, minutes long, always does. FAKE_E2_FAIL names a point that fails.
echo "lh-bench $*" >>"$HOME/lh-bench.log"
case "$1 $2" in
  "e2 engine") exec "$FAKE_LH_BENCH" "$@" ;;
  "e2 run")
    out=$(printf '%s\n' "$@" | grep -A1 -x -- --out | tail -1)
    if [[ -n ${FAKE_E2_FAIL:-} && $out == */"$FAKE_E2_FAIL" ]]; then
      mkdir -p "$out" && printf '{\n  "kind": "e2-point",\n  "status": "failed"\n}\n' >"$out/run.json"
      echo "lh-bench: the point failed" >&2
      exit 1
    fi
    for _ in $(seq 50); do
      compgen -G "$FAKE_HOSTS/*/nvidia-smi.log" >/dev/null && break
      sleep 0.1
    done
    mkdir -p "$out" && printf '{\n  "kind": "e2-point",\n  "status": "complete"\n}\n' >"$out/run.json"
    ;;
  "e2 report")
    out=$(printf '%s\n' "$@" | grep -A1 -x -- --out | tail -1)
    mkdir -p "$out" && echo "# E2 frontier" >"$out/frontier.md"
    ;;
  "e2 reset") echo "gateway: unchanged" ;;
  tiers\ *)
    out=$(printf '%s\n' "$@" | grep -A1 -x -- --out | tail -1)
    mkdir -p "$out"
    cat >"$out/summary.json" <<'JSON'
{"p50_ms": {"recompute": {"1024": 100.0, "8192": 546.0, "31744": 3242.0}, "gpu": {"1024": 36.0, "8192": 53.0,
 "31744": 133.0}, "cpu": {"1024": 42.0, "8192": 118.0, "31744": 325.0}},
 "fits": {"cpu_over_gpu": {"ms": 10.3, "us_per_token": 5.91}}}
JSON
    ;;
  *) echo "lh-bench: unexpected $*" >&2 && exit 2 ;;
esac
