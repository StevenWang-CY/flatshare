#!/usr/bin/env bash
# ssh in the campaign.sh tests: `ssh HOST COMMAND...` runs COMMAND with bash in $FAKE_HOSTS/HOST, the host's home, as
# its login shell would, and logs the call to $FAKE_HOSTS/ssh.log. FAKE_SSH_DOWN=HOST:REGEX drops the connection to
# HOST at the first command that matches REGEX: that call and every later one to HOST exit 255, as ssh does.
host=$1
shift
mkdir -p "$FAKE_HOSTS/$host"
printf '%s %s\n' "$host" "$*" >>"$FAKE_HOSTS/ssh.log"
if [[ -n ${FAKE_SSH_DOWN:-} && $host == "${FAKE_SSH_DOWN%%:*}" ]]; then
  regex=${FAKE_SSH_DOWN#*:}
  if [[ -e $FAKE_HOSTS/$host.down || $* =~ $regex ]]; then
    touch "$FAKE_HOSTS/$host.down"
    echo "ssh: connect to host $host port 22: Connection timed out" >&2
    exit 255
  fi
fi
cd "$FAKE_HOSTS/$host" && HOME=$FAKE_HOSTS/$host exec bash -c "$*"
