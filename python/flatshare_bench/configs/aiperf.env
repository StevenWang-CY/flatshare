# Environment for `aiperf profile --config configs/agentic_replay.yaml`; source it in the shell
# that runs AIPerf. AIPerf 0.13.0 reads these settings only from the environment.

# Keep each dataset AIPerf builds, its memory map, under ~/.cache/aiperf/dataset_mmap for later runs with the same
# key: the corpus's bytes, the tokenizer's name and revision, the seed, the dataset's settings and AIPerf's build. A
# round's points replay one corpus with one seed, so its first point builds the dataset and the others load it in
# seconds. AIPerf 0.13.0 caches only its own trace types; the plugin adds weka_trace_scaled and keeps its datasets in
# a directory named by a hash of its code and version, which the key does not cover, so a changed loader builds anew
# (aiperf_plugin.cache_datasets). Nothing evicts an entry.
export AIPERF_DATASET_MMAP_CACHE_ENABLED=true
# Keep off: when on, AIPerf overwrites the plugin's X-Session-ID (the session-tree root, shared by
# a parent and its subagents) with each agent's own correlation id.
export AIPERF_HTTP_X_SESSION_ID_FROM_CORRELATION_ID=false
# Weka loader processes (AIPerf's default is one per core, up to 16).
export AIPERF_DATASET_WEKA_PARALLEL_WORKERS=4
# Loading the full scaled corpus takes about 300 s, AIPerf's default timeout.
export AIPERF_DATASET_CONFIGURATION_TIMEOUT=900
export AIPERF_SERVICE_PROFILE_CONFIGURE_TIMEOUT=900

# flatshare_chat endpoint: class of every replayed session, and whether to send the vLLM
# priority field (false sends none, as a plain client would; vLLM acts on it only under
# --scheduling-policy priority).
export FLATSHARE_BENCH_CLASS=background
# export FLATSHARE_BENCH_SEND_PRIORITY=false
